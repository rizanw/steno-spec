{
  "manifestVersion": 2,
  "id": "steno",
  "name": "steno spec",
  "version": "0.1.5",
  "description": "Shorthand specs in your agent panel: spec-driven development that is agent-agnostic and token-efficient.",
  "license": "MIT",
  "repository": "https://github.com/rizanw/steno-spec/tree/main/packages/orca",
  "icon": "dist/icon.png",
  "engines": { "orca": ">=1.4.262" },
  "execution": "trusted-worker",
  "main": "dist/worker.mjs",
  "contributes": {
    "panels": [{ "id": "steno", "title": "steno", "icon": "file-text", "entry": "dist/panel.html", "ui": "html" }],
    "events": [{ "on": "workspace.changed" }]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "workspace:write" },
    { "kind": "agent:launch" },
    { "kind": "agent:read" },
    { "kind": "terminal:send" },
    { "kind": "storage:own" },
    { "kind": "notifications:show" }
  ]
}
