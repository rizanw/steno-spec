{
  "name": "steno-vscode",
  "displayName": "steno spec",
  "description": "Shorthand specs for any coding agent: requirements \u2192 design \u2192 tasks \u2192 execute, each stage linted and approved first.",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "publisher": "rizanw",
  "author": "rizanw",
  "homepage": "https://github.com/rizanw/steno-spec#readme",
  "bugs": "https://github.com/rizanw/steno-spec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizanw/steno-spec.git",
    "directory": "packages/vscode"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "spec-driven-development",
    "specs",
    "ears",
    "requirements",
    "coding-agent"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.steno"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the spec tree, diagnostics and task actions work as usual; handing work to a coding agent, choosing the agent and setting up steno are off until you trust the folder."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "steno.open",
        "title": "Open Spec Document at a Line",
        "category": "steno"
      },
      {
        "command": "steno.spec.new",
        "title": "New Spec",
        "category": "steno",
        "icon": "$(add)"
      },
      {
        "command": "steno.setUp",
        "title": "Set Up steno in a Folder",
        "category": "steno"
      },
      {
        "command": "steno.agent.choose",
        "title": "Choose Coding Agent",
        "category": "steno"
      },
      {
        "command": "steno.server.restart",
        "title": "Restart steno Server for This Folder",
        "category": "steno",
        "icon": "$(debug-restart)"
      },
      {
        "command": "steno.spec.approve",
        "title": "Approve This Phase",
        "category": "steno",
        "icon": "$(check)"
      },
      {
        "command": "steno.task.markDone",
        "title": "Mark Task Done",
        "category": "steno",
        "icon": "$(pass)"
      },
      {
        "command": "steno.task.reopen",
        "title": "Reopen Task",
        "category": "steno",
        "icon": "$(discard)"
      },
      {
        "command": "steno.task.done",
        "title": "Reopen Task",
        "category": "steno"
      },
      {
        "command": "steno.task.run",
        "title": "Run Task with Coding Agent",
        "category": "steno",
        "icon": "$(play)"
      },
      {
        "command": "steno.spec.runNext",
        "title": "Run Next Task with Coding Agent",
        "category": "steno",
        "icon": "$(run-all)"
      },
      {
        "command": "steno.spec.write",
        "title": "Write This Phase with Coding Agent",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.review",
        "title": "Review This Phase with Coding Agent",
        "category": "steno",
        "icon": "$(eye)"
      },
      {
        "command": "steno.steering.generate",
        "title": "Generate Steering with Coding Agent",
        "category": "steno",
        "icon": "$(sparkle)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "steno",
          "title": "steno",
          "icon": "media/steno.svg"
        }
      ]
    },
    "views": {
      "steno": [
        {
          "id": "steno.specs",
          "name": "specs",
          "icon": "media/steno.svg",
          "contextualTitle": "steno"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "steno.open",
          "when": "false"
        },
        {
          "command": "steno.spec.new",
          "when": "steno.hasProject"
        },
        {
          "command": "steno.setUp",
          "when": "!steno.hasProject || steno.canSetUp"
        },
        {
          "command": "steno.agent.choose",
          "when": "steno.hasProject"
        },
        {
          "command": "steno.server.restart",
          "when": "false"
        },
        {
          "command": "steno.spec.approve",
          "when": "false"
        },
        {
          "command": "steno.task.markDone",
          "when": "false"
        },
        {
          "command": "steno.task.reopen",
          "when": "false"
        },
        {
          "command": "steno.task.done",
          "when": "false"
        },
        {
          "command": "steno.task.run",
          "when": "false"
        },
        {
          "command": "steno.spec.runNext",
          "when": "false"
        },
        {
          "command": "steno.spec.write",
          "when": "false"
        },
        {
          "command": "steno.spec.review",
          "when": "false"
        },
        {
          "command": "steno.steering.generate",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && viewItem == folder.project",
          "group": "inline"
        },
        {
          "command": "steno.server.restart",
          "when": "view == steno.specs && viewItem == stopped",
          "group": "inline"
        },
        {
          "command": "steno.spec.approve",
          "when": "view == steno.specs && viewItem =~ /^spec\\..*\\.approvable$/",
          "group": "inline"
        },
        {
          "command": "steno.task.markDone",
          "when": "view == steno.specs && viewItem =~ /^task\\.open/",
          "group": "inline"
        },
        {
          "command": "steno.task.reopen",
          "when": "view == steno.specs && viewItem == task.done",
          "group": "inline"
        },
        {
          "command": "steno.task.run",
          "when": "view == steno.specs && viewItem == task.open.run",
          "group": "inline"
        },
        {
          "command": "steno.spec.runNext",
          "when": "view == steno.specs && viewItem == spec.execute",
          "group": "inline"
        },
        {
          "command": "steno.spec.write",
          "when": "view == steno.specs && viewItem =~ /^spec\\.(brief|requirements|design|tasks)/",
          "group": "inline"
        },
        {
          "command": "steno.spec.review",
          "when": "view == steno.specs && viewItem =~ /^spec\\.(requirements|design|tasks|done)/",
          "group": "inline"
        },
        {
          "command": "steno.steering.generate",
          "when": "view == steno.specs && viewItem == steering",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && steno.hasProject",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "steno.specs",
        "when": "!steno.hasProject",
        "contents": "No folder in this window is a steno project.\nSet one up to write specs with your coding agent.\n[Set up steno](command:steno.setUp)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && node build.mjs",
    "test:e2e": "tsc -p tsconfig.e2e.json && node out/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@steno/core": "workspace:*",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "ovsx": "^1.4.0",
    "steno-spec": "workspace:*",
    "vscode-languageclient": "^11.0.0"
  }
}
