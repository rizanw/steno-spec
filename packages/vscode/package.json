{
  "name": "steno-vscode",
  "displayName": "steno spec",
  "description": "Shorthand specs for any coding agent: requirements \u2192 design \u2192 tasks \u2192 execute, each stage linted and approved first.",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "publisher": "rzndwb",
  "author": "rizanw",
  "homepage": "https://github.com/rizanw/steno-spec#readme",
  "bugs": "https://github.com/rizanw/steno-spec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizanw/steno-spec.git",
    "directory": "packages/vscode"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "spec-driven-development",
    "specs",
    "ears",
    "requirements",
    "coding-agent"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.steno"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the spec tree, diagnostics and task actions work as usual; handing work to a coding agent, choosing the agent and setting up steno are off until you trust the folder."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "steno.open",
        "title": "Open Spec Document",
        "category": "steno"
      },
      {
        "command": "steno.spec.new",
        "title": "New Spec",
        "category": "steno",
        "icon": "$(add)"
      },
      {
        "command": "steno.setUp",
        "title": "Set Up steno in a Folder",
        "category": "steno"
      },
      {
        "command": "steno.agent.choose",
        "title": "Choose Coding Agent",
        "category": "steno"
      },
      {
        "command": "steno.server.restart",
        "title": "Restart steno Server",
        "category": "steno",
        "icon": "$(debug-restart)"
      },
      {
        "command": "steno.spec.approve",
        "title": "Approve",
        "category": "steno",
        "icon": "$(check)"
      },
      {
        "command": "steno.task.markDone",
        "title": "Mark Done",
        "category": "steno",
        "icon": "$(pass)"
      },
      {
        "command": "steno.task.reopen",
        "title": "Reopen",
        "category": "steno",
        "icon": "$(discard)"
      },
      {
        "command": "steno.spec.reopen",
        "title": "Reopen Spec",
        "category": "steno",
        "icon": "$(debug-restart)"
      },
      {
        "command": "steno.task.done",
        "title": "Reopen Task",
        "category": "steno"
      },
      {
        "command": "steno.task.run",
        "title": "Run Task",
        "category": "steno",
        "icon": "$(play)"
      },
      {
        "command": "steno.spec.runNext",
        "title": "Run Next Task",
        "category": "steno",
        "icon": "$(run-all)"
      },
      {
        "command": "steno.spec.write",
        "title": "Write This Phase",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.review",
        "title": "Review This Phase",
        "category": "steno",
        "icon": "$(eye)"
      },
      {
        "command": "steno.spec.write.brief",
        "title": "Write Brief",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.revise.brief",
        "title": "Revise Brief",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.write.requirements",
        "title": "Write Requirements",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.revise.requirements",
        "title": "Revise Requirements",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.write.design",
        "title": "Write Design",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.revise.design",
        "title": "Revise Design",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.write.tasks",
        "title": "Write Tasks",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.revise.tasks",
        "title": "Revise Tasks",
        "category": "steno",
        "icon": "$(edit)"
      },
      {
        "command": "steno.spec.review.requirements",
        "title": "Review Requirements",
        "category": "steno",
        "icon": "$(eye)"
      },
      {
        "command": "steno.spec.review.design",
        "title": "Review Design",
        "category": "steno",
        "icon": "$(eye)"
      },
      {
        "command": "steno.spec.review.tasks",
        "title": "Review Tasks",
        "category": "steno",
        "icon": "$(eye)"
      },
      {
        "command": "steno.spec.review.done",
        "title": "Review Drift",
        "category": "steno",
        "icon": "$(eye)"
      },
      {
        "command": "steno.steering.generate",
        "title": "Generate Steering",
        "category": "steno",
        "icon": "$(sparkle)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "steno",
          "title": "steno",
          "icon": "media/steno.svg"
        }
      ]
    },
    "views": {
      "steno": [
        {
          "id": "steno.specs",
          "name": "Specs",
          "icon": "media/steno.svg",
          "contextualTitle": "steno"
        },
        {
          "id": "steno.steering",
          "name": "Steering",
          "icon": "media/steno.svg",
          "contextualTitle": "steno",
          "when": "steno.hasProject"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "steno.open",
          "when": "false"
        },
        {
          "command": "steno.spec.new",
          "when": "steno.hasProject"
        },
        {
          "command": "steno.setUp",
          "when": "!steno.hasProject || steno.canSetUp"
        },
        {
          "command": "steno.agent.choose",
          "when": "steno.hasProject"
        },
        {
          "command": "steno.server.restart",
          "when": "false"
        },
        {
          "command": "steno.spec.approve",
          "when": "false"
        },
        {
          "command": "steno.task.markDone",
          "when": "false"
        },
        {
          "command": "steno.task.reopen",
          "when": "false"
        },
        {
          "command": "steno.spec.reopen",
          "when": "false"
        },
        {
          "command": "steno.task.done",
          "when": "false"
        },
        {
          "command": "steno.task.run",
          "when": "false"
        },
        {
          "command": "steno.spec.runNext",
          "when": "false"
        },
        {
          "command": "steno.spec.write",
          "when": "false"
        },
        {
          "command": "steno.spec.review",
          "when": "false"
        },
        {
          "command": "steno.spec.write.brief",
          "when": "false"
        },
        {
          "command": "steno.spec.revise.brief",
          "when": "false"
        },
        {
          "command": "steno.spec.write.requirements",
          "when": "false"
        },
        {
          "command": "steno.spec.revise.requirements",
          "when": "false"
        },
        {
          "command": "steno.spec.write.design",
          "when": "false"
        },
        {
          "command": "steno.spec.revise.design",
          "when": "false"
        },
        {
          "command": "steno.spec.write.tasks",
          "when": "false"
        },
        {
          "command": "steno.spec.revise.tasks",
          "when": "false"
        },
        {
          "command": "steno.spec.review.requirements",
          "when": "false"
        },
        {
          "command": "steno.spec.review.design",
          "when": "false"
        },
        {
          "command": "steno.spec.review.tasks",
          "when": "false"
        },
        {
          "command": "steno.spec.review.done",
          "when": "false"
        },
        {
          "command": "steno.steering.generate",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && viewItem == folder.project",
          "group": "inline"
        },
        {
          "command": "steno.server.restart",
          "when": "view == steno.specs && viewItem == stopped",
          "group": "inline"
        },
        {
          "command": "steno.spec.approve",
          "when": "view == steno.specs && viewItem == doc.approvable",
          "group": "inline"
        },
        {
          "command": "steno.task.markDone",
          "when": "view == steno.specs && viewItem =~ /^task\\.open/",
          "group": "inline"
        },
        {
          "command": "steno.task.reopen",
          "when": "view == steno.specs && viewItem == task.done",
          "group": "inline"
        },
        {
          "command": "steno.task.run",
          "when": "view == steno.specs && viewItem == task.open.run",
          "group": "inline"
        },
        {
          "command": "steno.spec.runNext",
          "when": "view == steno.specs && viewItem == spec.execute",
          "group": "inline"
        },
        {
          "command": "steno.spec.write.brief",
          "when": "view == steno.specs && viewItem =~ /^spec\\.brief(\\.approvable)?$/",
          "group": "inline"
        },
        {
          "command": "steno.spec.revise.brief",
          "when": "view == steno.specs && viewItem =~ /^spec\\.brief\\.written/",
          "group": "inline"
        },
        {
          "command": "steno.spec.write.requirements",
          "when": "view == steno.specs && viewItem =~ /^spec\\.requirements(\\.approvable)?$/",
          "group": "inline"
        },
        {
          "command": "steno.spec.revise.requirements",
          "when": "view == steno.specs && viewItem =~ /^spec\\.requirements\\.written/",
          "group": "inline"
        },
        {
          "command": "steno.spec.write.design",
          "when": "view == steno.specs && viewItem =~ /^spec\\.design(\\.approvable)?$/",
          "group": "inline"
        },
        {
          "command": "steno.spec.revise.design",
          "when": "view == steno.specs && viewItem =~ /^spec\\.design\\.written/",
          "group": "inline"
        },
        {
          "command": "steno.spec.write.tasks",
          "when": "view == steno.specs && viewItem =~ /^spec\\.tasks(\\.approvable)?$/",
          "group": "inline"
        },
        {
          "command": "steno.spec.revise.tasks",
          "when": "view == steno.specs && viewItem =~ /^spec\\.tasks\\.written/",
          "group": "inline"
        },
        {
          "command": "steno.spec.review.requirements",
          "when": "view == steno.specs && viewItem =~ /^spec\\.requirements(\\.|$)/",
          "group": "inline"
        },
        {
          "command": "steno.spec.review.design",
          "when": "view == steno.specs && viewItem =~ /^spec\\.design(\\.|$)/",
          "group": "inline"
        },
        {
          "command": "steno.spec.review.tasks",
          "when": "view == steno.specs && viewItem =~ /^spec\\.tasks(\\.|$)/",
          "group": "inline"
        },
        {
          "command": "steno.spec.review.done",
          "when": "view == steno.specs && viewItem =~ /^spec\\.done(\\.|$)/",
          "group": "inline"
        },
        {
          "command": "steno.steering.generate",
          "when": "view == steno.steering && viewItem == folder.project",
          "group": "inline"
        },
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && viewItem == folder.project",
          "group": "1_agent@1"
        },
        {
          "command": "steno.server.restart",
          "when": "view == steno.specs && viewItem == stopped",
          "group": "2_change@1"
        },
        {
          "command": "steno.spec.approve",
          "when": "view == steno.specs && viewItem =~ /\\.approvable$/",
          "group": "2_change@1"
        },
        {
          "command": "steno.task.markDone",
          "when": "view == steno.specs && viewItem =~ /^task\\.open/",
          "group": "2_change@1"
        },
        {
          "command": "steno.task.reopen",
          "when": "view == steno.specs && viewItem == task.done",
          "group": "2_change@2"
        },
        {
          "command": "steno.task.run",
          "when": "view == steno.specs && viewItem == task.open.run",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.runNext",
          "when": "view == steno.specs && viewItem == spec.execute",
          "group": "1_agent@3"
        },
        {
          "command": "steno.spec.write.brief",
          "when": "view == steno.specs && viewItem =~ /^spec\\.brief(\\.approvable)?$/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.revise.brief",
          "when": "view == steno.specs && viewItem =~ /^spec\\.brief\\.written/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.write.requirements",
          "when": "view == steno.specs && viewItem =~ /^spec\\.requirements(\\.approvable)?$/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.revise.requirements",
          "when": "view == steno.specs && viewItem =~ /^spec\\.requirements\\.written/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.write.design",
          "when": "view == steno.specs && viewItem =~ /^spec\\.design(\\.approvable)?$/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.revise.design",
          "when": "view == steno.specs && viewItem =~ /^spec\\.design\\.written/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.write.tasks",
          "when": "view == steno.specs && viewItem =~ /^spec\\.tasks(\\.approvable)?$/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.revise.tasks",
          "when": "view == steno.specs && viewItem =~ /^spec\\.tasks\\.written/",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.review.requirements",
          "when": "view == steno.specs && viewItem =~ /^spec\\.requirements(\\.|$)/",
          "group": "1_agent@2"
        },
        {
          "command": "steno.spec.review.design",
          "when": "view == steno.specs && viewItem =~ /^spec\\.design(\\.|$)/",
          "group": "1_agent@2"
        },
        {
          "command": "steno.spec.review.tasks",
          "when": "view == steno.specs && viewItem =~ /^spec\\.tasks(\\.|$)/",
          "group": "1_agent@2"
        },
        {
          "command": "steno.spec.review.done",
          "when": "view == steno.specs && viewItem =~ /^spec\\.done(\\.|$)/",
          "group": "1_agent@2"
        },
        {
          "command": "steno.steering.generate",
          "when": "view == steno.steering && viewItem == folder.project",
          "group": "1_agent@1"
        },
        {
          "command": "steno.spec.reopen",
          "when": "view == steno.specs && viewItem == spec.done",
          "group": "2_change@2"
        }
      ],
      "view/title": [
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && steno.hasProject",
          "group": "navigation"
        },
        {
          "command": "steno.steering.generate",
          "when": "view == steno.steering && steno.hasProject",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "steno.specs",
        "when": "!steno.hasProject",
        "contents": "No folder in this window is a steno project.\nSet one up to write specs with your coding agent.\n[Set up steno](command:steno.setUp)"
      },
      {
        "view": "steno.steering",
        "when": "steno.hasProject",
        "contents": "No steering files yet. Steering tells your coding agent what this project is and how it is built.\n[Generate steering](command:steno.steering.generate)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && node build.mjs",
    "test:e2e": "tsc -p tsconfig.e2e.json && node out/e2e/run.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@steno/core": "workspace:*",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "ovsx": "^1.4.0",
    "steno-spec": "workspace:*",
    "vscode-languageclient": "^11.0.0"
  }
}
