{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "vscode": ["./test/vscode-stub.ts"],
      "vscode-languageclient/node": ["./test/languageclient-stub.ts"]
    },
    "composite": false,
    "declaration": false,
    "noEmit": true
  },
  "include": ["test", "vitest.config.ts"],
  // the end-to-end files run against the real `vscode` module: tsconfig.e2e.json checks them
  "exclude": ["test/e2e"]
}
