{
  "name": "steno-vscode",
  "displayName": "steno spec",
  "description": "Shorthand specs for any coding agent: requirements \u2192 design \u2192 tasks \u2192 execute, each stage linted and approved first.",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "publisher": "rizanw",
  "author": "rizanw",
  "homepage": "https://github.com/rizanw/steno-spec#readme",
  "bugs": "https://github.com/rizanw/steno-spec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizanw/steno-spec.git",
    "directory": "packages/vscode"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "spec-driven-development",
    "specs",
    "ears",
    "requirements",
    "coding-agent"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.steno"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "steno.open",
        "title": "Open Spec Document at a Line",
        "category": "steno"
      },
      {
        "command": "steno.spec.new",
        "title": "New Spec",
        "category": "steno",
        "icon": "$(add)"
      },
      {
        "command": "steno.server.restart",
        "title": "Restart steno Server for This Folder",
        "category": "steno",
        "icon": "$(debug-restart)"
      },
      {
        "command": "steno.spec.approve",
        "title": "Approve This Phase",
        "category": "steno",
        "icon": "$(check)"
      },
      {
        "command": "steno.task.markDone",
        "title": "Mark Task Done",
        "category": "steno",
        "icon": "$(pass)"
      },
      {
        "command": "steno.task.reopen",
        "title": "Reopen Task",
        "category": "steno",
        "icon": "$(discard)"
      },
      {
        "command": "steno.task.done",
        "title": "Reopen Task",
        "category": "steno"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "steno",
          "title": "steno",
          "icon": "media/steno.svg"
        }
      ]
    },
    "views": {
      "steno": [
        {
          "id": "steno.specs",
          "name": "specs",
          "icon": "media/steno.svg",
          "contextualTitle": "steno specs"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "steno.open",
          "when": "false"
        },
        {
          "command": "steno.spec.new",
          "when": "steno.hasProject"
        },
        {
          "command": "steno.server.restart",
          "when": "false"
        },
        {
          "command": "steno.spec.approve",
          "when": "false"
        },
        {
          "command": "steno.task.markDone",
          "when": "false"
        },
        {
          "command": "steno.task.reopen",
          "when": "false"
        },
        {
          "command": "steno.task.done",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && viewItem == folder.project",
          "group": "inline"
        },
        {
          "command": "steno.server.restart",
          "when": "view == steno.specs && viewItem == stopped",
          "group": "inline"
        },
        {
          "command": "steno.spec.approve",
          "when": "view == steno.specs && viewItem == spec.approvable",
          "group": "inline"
        },
        {
          "command": "steno.task.markDone",
          "when": "view == steno.specs && viewItem == task.open",
          "group": "inline"
        },
        {
          "command": "steno.task.reopen",
          "when": "view == steno.specs && viewItem == task.done",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "steno.spec.new",
          "when": "view == steno.specs && steno.hasProject",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "steno.specs",
        "when": "!steno.hasProject",
        "contents": "No folder in this window is a steno project.\nsteno keeps specs as plain Markdown under `.steno/`, and this view follows them. Run `steno init` in a terminal to start one, then ask your coding agent for a spec.\n[Getting started](https://github.com/rizanw/steno-spec/blob/main/docs/getting-started.md)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && node build.mjs",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@steno/core": "workspace:*",
    "@types/vscode": "1.125.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "ovsx": "^1.4.0",
    "steno-spec": "workspace:*",
    "vscode-languageclient": "^11.0.0"
  }
}
