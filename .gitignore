# dependencies
node_modules/

# build and test output
dist/
*.tsbuildinfo
*.tgz
coverage/

# generated by packages/cli/build.mjs
packages/cli/bin/
packages/cli/skills/
packages/cli/README.md
packages/cli/LICENSE
packages/cli/JSON-CONTRACT.md

# generated by packages/vscode/build.mjs
packages/vscode/LICENSE
packages/vscode/media/
packages/vscode/skills/
packages/vscode/*.vsix

# generated by packages/paseo/scripts/build.mjs
packages/paseo/server/vendor/
packages/paseo/media/

# the end-to-end tests: compiled files and the downloaded VS Code
packages/vscode/out/
packages/vscode/.vscode-test/

# installed by `steno init` (canonical copies live in packages/skills)
.agents/
.claude/skills/
.claude/agents/steno-reviewer-*.md

# local steno workspace used while developing steno itself
.steno/
# the example project commits its spec so readers can see real steno output
!examples/*/.steno/

# local tool state
.fallow/
.claude/settings.local.json
.codegraph/

# secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.steno
