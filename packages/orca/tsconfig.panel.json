{
  // The panel is a page in Orca's sidebar: browser DOM, Preact's JSX and the frame's global `orca`. The worker's
  // tsconfig.json has Node and Orca's component JSX instead, so each part is checked against what it really runs on.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "typeRoots": ["./types"],
    "types": ["orca", "orca-host", "orca-frame", "orca-services"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/panel", "src/shared"]
}
